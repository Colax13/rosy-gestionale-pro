# Rosy — variabili d'ambiente.
# In sviluppo: copia questo file in `.env.local` e riempilo.
# In produzione: le stesse voci vanno su Vercel → Settings → Environment Variables.
# Le voci VITE_… finiscono nel programma che scarica il browser: niente segreti lì.

# --- Firebase (browser): Console Firebase → Impostazioni progetto → Le tue app → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Solo se il database Firestore non è quello predefinito:
# VITE_FIREBASE_DATABASE_ID=(default)

# --- Firebase (server): la chiave del "service account", tutta su una riga (JSON)
FIREBASE_SERVICE_ACCOUNT=
# FIRESTORE_DATABASE_ID=(default)

# --- Chi gestisce Rosy (pannello "Saloni iscritti"). Indirizzi separati da virgola.
# Il primo decide chi ENTRA (server); il secondo mostra solo la voce nel menù.
ADMIN_EMAILS=
VITE_ADMIN_EMAILS=

# --- Come ti contatta un salone per attivare un piano (finché non c'è Stripe)
VITE_CONTATTO_WHATSAPP=
VITE_CONTATTO_EMAIL=

# --- Rosy, l'IA. Almeno una delle tre; le altre fanno da riserva gratuita.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- L'indirizzo pubblico del prodotto (es. https://rosy.it)
APP_URL=

# --- Il giro dei promemoria (Vercel Cron): una parola segreta a tua scelta
CRON_SECRET=

# --- SMS: accesi salone per salone (email dei titolari, separate da virgola).
# Vuoto = nessun SMS: le clienti ricevono solo quello che il salone manda a mano.
SALONI_CON_SMS=
VITE_SALONI_CON_SMS=
