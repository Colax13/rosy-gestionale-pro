{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/rosy.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:indirizzo((?!agenda$|clienti$|catalogo$|report$|dipendenti$|settings$|prodotti$|automazioni$|buoni-spa$|buoni$|rosy$|rosie$|hub$|admin$|api$|assets$|icone$|accesso$|login$|prenota$|privacy$|termini$|prezzi$|piani$|demo$|anteprima$|www$|app$|help$|aiuto$|index$|manifest$|favicon$|robots$|sitemap$|rosy-chat$)[a-z0-9][a-z0-9-]{1,38}[a-z0-9])",
      "destination": "/api/pagina?indirizzo=:indirizzo"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/promemoria",
      "schedule": "0 10 * * *"
    }
  ]
}
